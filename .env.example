# Copy to .env and fill in. .env is git-ignored and must never be committed.
#   cp .env.example .env && chmod 600 .env && $EDITOR .env
#
# run.sh reads these, writes a chmod-600 temporary MySQL defaults file, and
# passes --defaults-extra-file. The password is therefore never visible in
# `ps`, never in shell history, and never on a command line.

DRA_MYSQL_USER=dra_app
DRA_MYSQL_PASSWORD=change-me
DRA_MYSQL_HOST=127.0.0.1
DRA_MYSQL_PORT=3306
DRA_MYSQL_DB=disaster_relief

# Optional. Absolute path to the mysql client if it is not on your PATH.
# macOS official .dmg install, for example:
# MYSQL_BIN=/usr/local/mysql/bin/mysql
